# Apache / cPanel — config pentru /galati_map/
# Înlocuiește fostul `_headers` (format Netlify/Cloudflare, INACTIV pe Apache).
# Acoperă: cache per tip de fișier, headere de securitate, compresie gzip
# (Brotli e deja activ pe host pentru clienții care trimit `br`).
#
# Notă: cache-ul imutabil pentru vendor/ e în galati_map/vendor/.htaccess
# (un .htaccess de subdirector suprascrie regulile de aici pentru acel folder).

<IfModule mod_headers.c>
  # HTML — mereu revalidat, ca deploy-urile să fie vizibile imediat.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Date JSON / GeoJSON — cache scurt + revalidare în fundal.
  <FilesMatch "\.(json|geojson)$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=3600"
  </FilesMatch>

  # JS / CSS de aplicație (main.js, module ES, styles) — NU au hash în nume,
  # deci revalidare scurtă; service worker-ul servește din cache între timp.
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=600, stale-while-revalidate=86400"
  </FilesMatch>

  # Service worker — niciodată cache agresiv (trebuie să preia update-urile).
  # Plasat DUPĂ regula .js ca să o suprascrie pentru sw.js.
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Headere de securitate (lipseau complet — _headers nu se aplica pe Apache).
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  # Geolocalizarea e folosită de aventurile GPS (doar same-origin).
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
</IfModule>

# Compresie pentru clienții fără Brotli (gzip).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/geo+json application/manifest+json
</IfModule>

# Tipuri MIME corecte (unele configurări cPanel nu le au pe toate).
<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/geo+json .geojson
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# Listarea de directoare. Fără asta, un director fără index.html se răsfoiește
# liber: /galati_map/js/, /galati_map/styles/ și /assets/images/ răspundeau cu
# lista completă de fișiere. Nu e un secret expus, codul e public oricum, dar
# oferă gratis harta structurii pentru cine caută ce să sondeze.
Options -Indexes

# ─── Content-Security-Policy ────────────────────────────────────────────────
# Ce apără: dacă vreodată ajunge conținut străin în pagină (o descriere cu HTML,
# o legendă de imagine, un parametru de URL reflectat), politica îl împiedică să
# execute cod sau să trimită date în afară.
#
# `script-src 'self'` fără `unsafe-inline` a fost posibil abia după ce cele două
# tipare de handlere inline au fost mutate în `js/inline-shims.js`: rezerva
# WebP → JPEG a miniaturilor (217 atribute `onerror`) și comutarea celor două
# `<link rel=preload as=style>` la `stylesheet`. Codul din atribute e blocat de
# CSP la fel ca un `<script>` inline.
#
# Blocurile `application/ld+json` NU sunt afectate: nu se execută ca JavaScript.
#
# `style-src` păstrează `unsafe-inline` fiindcă randarea produce peste 400 de
# atribute `style` (culori de categorie, poziții pe riglă). Riscul dinspre stiluri
# e mult mai mic decât cel dinspre scripturi, iar eliminarea lor ar cere
# rescrierea randării.
#
# Origini externe, toate verificate în browser înainte de a fi permise:
#   *.basemaps.cartocdn.com   tile-urile hărții de bază
#   services.geo-spatial.org  stratul WMS de hărți istorice (eHarta)
#
# ATENȚIE la analytics: `js/analytics.js` e dezactivat (`GC_CODE = ''`). Când îl
# activezi, GoatCounter încarcă `gc.zgo.at` și trimite către `*.goatcounter.com`,
# deci trebuie adăugate aici, altfel nu numără nimic și pare că nu merge.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://services.geo-spatial.org; font-src 'self'; connect-src 'self' https://services.geo-spatial.org; worker-src 'self'; manifest-src 'self'; media-src 'self'"
  </FilesMatch>

  # Pagina AR are nevoie de mai mult: A-Frame și AR.js vin de pe CDN-uri fixate
  # pe versiune, cu `integrity`, iar A-Frame nu pornește deloc fără
  # `unsafe-eval` (verificat: fără el aruncă EvalError la inițializare și
  # `AFRAME` rămâne undefined). Camera livrează cadrele ca `mediastream:` și
  # `blob:`. Politica largă se aplică strict acestui fișier, nu întregului site.
  # Scriptul propriu al paginii a fost mutat în `js/piata-regala-ar.js`, iar cele
  # trei butoane cu `onclick` folosesc acum `data-act`, deci nici aici nu e
  # nevoie de `unsafe-inline`.
  <Files "piata-regala-ar.html">
    Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-eval' https://aframe.io https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://aframe.io https://cdn.jsdelivr.net; media-src 'self' blob: mediastream:; worker-src 'self' blob:"
  </Files>
</IfModule>
