# Netlify / Cloudflare Pages cache configuration
# Static immutable assets — vendor JS/CSS, fonts, marker icons (versioned URLs change rarely)
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Images — local + commons + pubcrawl (rarely change once added)
/assets/images/*
  Cache-Control: public, max-age=2592000

# Articles HTML — rarely change
/assets/articles/*
  Cache-Control: public, max-age=86400

# Data JSON — change with each content update; short cache + must-revalidate
/galati_map/locations.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/galati_map/tours.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/galati_map/cartiere.geojson
  Cache-Control: public, max-age=86400
/galati_map/valuri.geojson
  Cache-Control: public, max-age=86400
/galati_map/pubcrawl_photos.json
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
/galati_map/tours_routes.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML pages — never cache aggressively (so deploys are visible)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Service worker — must always revalidate to pick up updates
/galati_map/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Generic security headers
/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
